{
  "name": "joist-graphql-sample",
  "scripts": {
    "test": "jest",
    "pg-migrate": "./env tsx ./node_modules/joist-migration-utils",
    "pg-new-migration": "node-pg-migrate create --template-file-name=migrations/.template.ts",
    "joist-codegen": "./env joist-codegen",
    "graphql-codegen": "graphql-codegen --config graphql-codegen.js",
    "codegen": "yarn joist-codegen && yarn graphql-codegen",
    "format": "prettier --write 'src/**/*.{ts,js,tsx,jsx}'",
    "build": "tsc",
    "start": "docker compose up graphql",
    "db": "./env sh -c 'docker compose up --wait db && yarn pg-migrate && yarn joist-codegen'",
    "redb": "./env sh -c 'docker compose up --wait db && docker compose exec db ./reset.sh && yarn pg-migrate && yarn codegen'",
    "psql": "docker compose exec db psql --username sample_user --dbname sample_app"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephenh/joist-graphql-sample.git"
  },
  "license": "ISC",
  "homepage": "https://github.com/stephenh/joist-graphql-sample#readme",
  "prettier": {
    "trailingComma": "all",
    "printWidth": 120
  },
  "dependencies": {
    "@graphql-tools/graphql-file-loader": "^8.1.20",
    "@graphql-tools/load": "^8.1.17",
    "@graphql-tools/schema": "^10.1.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "graphql": "16.14.2",
    "graphql-scalars": "^2.0.0",
    "joist-orm": "2.4.0",
    "knex": "^3.3.0",
    "mercurius": "^16.10.1",
    "pg": "^8.23.0",
    "pg-connection-string": "^2.14.0",
    "pg-types": "^4.1.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.3",
    "@homebound/graphql-typescript-possible-types": "^2.19.0",
    "@homebound/graphql-typescript-resolver-scaffolding": "^2.49.0",
    "@homebound/graphql-typescript-simple-resolvers": "^1.59.0",
    "@homebound/tsconfig": "^1.2.0",
    "@tsconfig/recommended": "^1.0.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "node-pg-migrate": "^8.0.4",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "joist-graphql-resolver-utils/graphql": "16.14.2"
  },
  "packageManager": "yarn@4.9.2"
}
